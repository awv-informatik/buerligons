# buerligons as the app of a ClassCAD MCP: `vite build --mode mcp`.
#
# The MCP serves this build on its local address and is itself what the app
# reaches ClassCAD through: the address has no scheme, so it is taken on the
# server the page came from. The page is opened with ?invite=<token> and joins
# the agent's session as a guest. No engine runs in the page, so no key.
WSCLIENT_URL=/session
CLASSCAD_WASM_KEY=
SOCKETIO_URL=
