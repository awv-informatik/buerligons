{
  "name": "buerligons",
  "homepage": "./",
  "packageManager": "yarn@1.19.1",
  "version": "0.0.1",
  "author": "AWV Informatik AG <info@awv-informatik.ch>",
  "repository": "https://github.com/awv-informatik/buerligons",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 9093",
    "build": "npm run clean && USE_SIMPLE_CSS_MINIFIER=true docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clean": "npx rimraf build && npx rimraf .docusaurus && npx rimraf node_modules/.cache",
    "clear": "docusaurus clear && npx rimraf docs && npx rimraf static/doc/assets && npx rimraf node_modules/@awvinf",
    "serve": "docusaurus serve --port 9093",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "deploy:prod": "firebase deploy --only hosting:production",
    "deploy:dev": "firebase deploy --only hosting:dev",
    "deploy:prev": "firebase hosting:channel:deploy preview-01 --expires 1d --only dev"
  },
  "engines": {
    "node": ">=16.14.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@buerli.io/icons": "^1.0.16",
    "@buerli.io/react-cad": "0.13.1-beta.4",
    "@docusaurus/core": "^3.7.0",
    "@docusaurus/faster": "^3.7.0",
    "@docusaurus/plugin-ideal-image": "^3.7.0",
    "@docusaurus/preset-classic": "^3.7.0",
    "@docusaurus/remark-plugin-npm2yarn": "^3.7.0",
    "@easyops-cn/docusaurus-search-local": "^0.49.1",
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@juggle/resize-observer": "^3.4.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@react-three/drei": "9.92.3",
    "@react-three/fiber": "8.15.14",
    "@react-three/postprocessing": "2.15.0",
    "@tailwindcss/typography": "^0.5.16",
    "antd": "^4.23.4",
    "arraybuffer-loader": "1.0.8",
    "clsx": "^2.1.1",
    "postprocessing": "6.33.0",
    "prism-react-renderer": "^2.4.1",
    "react": "18.0.0",
    "react-dom": "18.0.0",
    "react-icons": "^5.3.0",
    "react-is": "^16.8.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-toastify": "^11.0.5",
    "three": "0.153",
    "three-stdlib": "2.23.5",
    "zustand": "4.1.4"
  },
  "devDependencies": {
    "@babel/core": "^7.4.5",
    "@docusaurus/module-type-aliases": "^3.7.0",
    "@docusaurus/tsconfig": "^3.7.0",
    "@docusaurus/types": "^3.7.0",
    "@tailwindcss/postcss": "^4.0.15",
    "@testing-library/dom": "^7.21.4",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@tsconfig/docusaurus": "^2.0.3",
    "@types/jest": "^27.0.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/styled-components": "^5.1.14",
    "@types/three": "0.152.1",
    "@types/uuid": "^8.3.1",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "@vitejs/plugin-react": "^4.0.4",
    "babel-plugin-import": "^1.13.8",
    "docusaurus-plugin-module-alias": "^0.0.2",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^7.0.2",
    "less": "^4.1.3",
    "lint-staged": "^11.1.2",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "rimraf": "^3.0.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.1.6",
    "url-loader": "^4.1.1",
    "vite": "^4.4.8",
    "vite-plugin-checker": "^0.6.1",
    "vite-plugin-svgr": "^3.2.0",
    "vite-tsconfig-paths": "^4.2.0",
    "webpack-bundle-analyzer": "^4.4.2"
  },
  "resolutions": {
    "postprocessing": "6.33.0"
  }
}
