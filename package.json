{
  "name": "buerligons",
  "homepage": "./",
  "version": "0.0.1",
  "author": "AWV Informatik AG <info@awv-informatik.ch>",
  "repository": "https://github.com/awv-informatik/buerligons",
  "private": true,
  "scripts": {
    "clean": "rimraf ./build",
    "dev": "npm run start",
    "start": "vite",
    "build": "tsc && vite build",
    "build:mcp": "tsc && vite build --mode mcp",
    "serve": "vite preview",
    "compile": "tsc",
    "lint": "eslint \"./src/**/*.ts?(x)\""
  },
  "engines": {
    "node": ">=16.14.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@buerli.io/classcad": "1.2.0",
    "@buerli.io/core": "1.2.0",
    "@buerli.io/react": "1.2.0",
    "@buerli.io/react-cad": "1.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "antd": "^6.6.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "styled-components": "^6.5.3",
    "three": "~0.184.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.184.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.14.5"
  }
}
